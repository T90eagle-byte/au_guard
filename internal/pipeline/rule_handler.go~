package pipeline

import (
	"context"
	"fmt"

	"example.org/auguard/internal/events"
)

type RuleHandler struct{}

func (RuleHandler) Handle(
	ctx context.Context, e events.Event,
) (events.Decision, error) {
	if err := ctx.Err(); err != nil {
		return events.Decision{}, fmt.Errorf("handle event: %w", err)
	}

	if err := e.Validate(); err != nil {
		return events.Decision{}, fmt.Errorf("handle event: %v", err)
	}

	decision := events.Decision{
		EventID: e.ID,
		Action:  "observe",
		Reason:  "low_severity",
	}

	if e.Severity >= 7 {
		decision.Action = "review"
		decision.Reason = "high_severity"
	}

	return decision, nil
}

var _ EventHandler = RuleHandler{}
