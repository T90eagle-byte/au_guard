package events

type Event struct {
	ID       string `json:"id"`
	Kind     string `json:"kind"`
	Severity int    `json:"severity"`
	Message  string `json:"message"`
	Artifact string `json:"artifact,omitempty"`
}

func (e Event) Validate() error {
	if len(e.ID) < 1 || len(e.ID) > 64 {
		return &ValidationError{Field: "id"}
	}

	for i := 0; i < len(e.ID); i++ {
		c := e.ID[i]
		if !((c >= 'A' && c <= 'Z') ||
			(c >= 'a' && c <= 'z') ||
			(c >= '0' && c <= '9') ||
			c == '_' || c == '-') {
			return &ValidationError{Field: "id"}
		}
	}

	if e.Kind != "auth" && e.Kind != "file" && e.Kind != "process" {
		return &ValidationError{Field: "kind"}
	}

	if e.Severity < 0 || e.Severity > 10 {
		return &ValidationError{Field: "severity"}
	}

	if !utf8.ValidString(e.Message) || len(e.Message) > 4096 {
		return &ValidationError{Field: "message"}
	}

	if e.Artifact != "" {
		if len(e.Artifact) > 256 ||
			strings.HasPrefix(e.Artifact, "/") ||
			strings.Contains(e.Artifact, "\\") ||
			strings.ContainsRune(e.Artifact, '\x00') {
			return &ValidationError{Field: "artifact"}
		}

		for _, part := range strings.Split(e.Artifact, "/") {
			if part == ".." {
				return &ValidationError{Field: "artifact"}
			}
		}
	}

	return nil
}
